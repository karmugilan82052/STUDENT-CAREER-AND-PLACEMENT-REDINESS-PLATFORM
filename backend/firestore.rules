rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User helper
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Is Admin
    function isAdmin() {
      return request.auth != null && getRole() == 'admin';
    }

    // Is Student
    function isStudent(userId) {
      return request.auth != null && (request.auth.uid == userId || getRole() == 'admin');
    }

    // Users Collection rules
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Students Collection rules
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isStudent(studentId);
    }

    // Skills Collection
    match /skills/{studentId} {
      allow read: if request.auth != null;
      allow write: if isStudent(studentId);
    }

    // Resumes Collection
    match /resumes/{resumeId} {
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Resume Analysis
    match /resumeAnalysis/{analysisId} {
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Projects & Certifications
    match /projects/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }
    match /certifications/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Applications
    match /applications/{appId} {
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Interviews
    match /interviews/{id} {
      allow read: if request.auth != null && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (request.resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Recommendations
    match /recommendations/{studentId} {
      allow read: if request.auth != null && (studentId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (studentId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{id} {
      allow read: if request.auth != null && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'all' || isAdmin());
      allow write: if request.auth != null;
    }

    // Chat History
    match /chatHistory/{studentId} {
      allow read, write: if request.auth != null && (studentId == request.auth.uid || isAdmin());
    }

    // Settings
    match /settings/{id} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
